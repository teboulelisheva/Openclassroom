# =========================================================
# Copiez ce fichier en ".env" et adaptez les valeurs.
#   cp .env.example .env
# Le fichier .env est ignoré par Git (ne jamais versionner
# de secrets).
# =========================================================

# --- Backend FastAPI ---
BACKEND_PORT=8000
ENVIRONMENT=development

# --- MongoDB ---
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_DB=ffe_chess

# --- Milvus ---
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091

# --- Frontend (étape ultérieure) ---
FRONTEND_PORT=4200
