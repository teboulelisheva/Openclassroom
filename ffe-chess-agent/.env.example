# =========================================================
# Copiez ce fichier en ".env" et adaptez les valeurs.
#   cp .env.example .env
# Le fichier .env est ignoré par Git (ne jamais versionner
# de secrets).
# =========================================================

# --- Backend FastAPI ---
BACKEND_PORT=8000
ENVIRONMENT=development

# --- MongoDB ---
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_DB=ffe_chess

# --- Milvus ---
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091

# --- Clés API externes ---
# Token Lichess (Opening Explorer) : https://lichess.org/account/oauth/token
LICHESS_TOKEN=
# Clé YouTube Data API v3 : https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Frontend (étape ultérieure) ---
FRONTEND_PORT=4200
